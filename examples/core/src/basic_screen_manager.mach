use std.runtime;
use rl: raylib.raylib;

def GameScreen: u32;
val LOGO: GameScreen = 0;
val TITLE: GameScreen = 1;
val GAMEPLAY: GameScreen = 2;
val ENDING: GameScreen = 3;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val sw: i32 = 600;
    val sh: i32 = 200;
    rl.init_window(sw, sh, "basic screen manager");
    rl.set_target_fps(60);

    var current_screen: GameScreen = LOGO;
    var frames_counter: i32 = 0;

    for (!rl.window_should_close()) {

        if (current_screen == LOGO) {
            frames_counter = frames_counter + 1;
            if (frames_counter > 120) {
                current_screen = TITLE;
            }
        } or (current_screen == TITLE) {
            if (rl.is_key_pressed(rl.KEY_ENTER) || rl.is_gesture_detected(rl.GESTURE_TAP::u32)) {
                current_screen = GAMEPLAY;
            }
        } or (current_screen == GAMEPLAY) {
            if (rl.is_key_pressed(rl.KEY_ENTER) || rl.is_gesture_detected(rl.GESTURE_TAP::u32)) {
                current_screen = ENDING;
            }
        } or (current_screen == ENDING) {
            if (rl.is_key_pressed(rl.KEY_ENTER) || rl.is_gesture_detected(rl.GESTURE_TAP::u32)) {
                current_screen = TITLE;
            }
        }

        rl.begin_drawing();
            rl.clear_background(rl.LIGHTGRAY);
            if (current_screen == LOGO) {
                rl.draw_text("LOGO SCREEN", 20, 20, 40, rl.LIGHTGRAY);
                rl.draw_text("WAIT for 2 SECONDS...", 150, 100, 20, rl.GRAY);
            } or (current_screen == TITLE) {
                rl.draw_rectangle(0, 0, sw, sh, rl.GREEN);

                rl.draw_text("TITLE SCREEN", 10, 20, 40, rl.DARKGREEN);
                rl.draw_text("PRESS ENTER or TAP to JUMP to GAMEPLAY SCREEN", 10, 100, 20, rl.DARKGREEN);
            } or (current_screen == GAMEPLAY) {
                rl.draw_rectangle(0, 0, sw, sh, rl.PURPLE);
                rl.draw_text("GAMEPLAY SCREEN", 10, 20, 40, rl.MAROON);
                rl.draw_text("PRESS ENTER or TAP to JUMP to ENDING SCREEN", 10, 100, 20, rl.MAROON);
            } or (current_screen == ENDING) {
                rl.draw_rectangle(0, 0, sw, sh, rl.BLUE);
                rl.draw_text("ENDING SCREEN", 10, 20, 40, rl.DARKBLUE);
                rl.draw_text("PRESS ENTER or TAP to RETURN to TITLE SCREEN", 10, 100, 20, rl.DARKBLUE);
            }
        rl.end_drawing();
    }

    rl.close_window();
    ret 0;
}

