use std.runtime;
use raylib.ra;

def GameScreen: u32;
val LOGO: GameScreen = 0;
val TITLE: GameScreen = 1;
val GAMEPLAY: GameScreen = 2;
val ENDING: GameScreen = 3;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    # -- Init -----------
    val sw: i32 = 600;
    val sh: i32 = 200;
    ra.init_window(sw, sh, "basic screen manager");
    ra.set_target_fps(60);

    var current_screen: GameScreen = LOGO;
    var frames_counter: i32 = 0;
    # --- Main loop -----
    for (!ra.window_should_close()) {
        # -- Update -----
        if (current_screen == LOGO) {
            frames_counter = frames_counter + 1;
            if (frames_counter > 120) {
                current_screen = TITLE;
            }
        } or (current_screen == TITLE) {
            if (ra.is_key_pressed(ra.KEY_ENTER) || ra.is_gesture_detected(ra.GESTURE_TAP::u32)) {
                current_screen = GAMEPLAY;
            }
        } or (current_screen == GAMEPLAY) {
            if (ra.is_key_pressed(ra.KEY_ENTER) || ra.is_gesture_detected(ra.GESTURE_TAP::u32)) {
                current_screen = ENDING;
            }
        } or (current_screen == ENDING) {
            if (ra.is_key_pressed(ra.KEY_ENTER) || ra.is_gesture_detected(ra.GESTURE_TAP::u32)) {
                current_screen = TITLE;
            }
        }
        # -- Draw -------
        ra.begin_drawing();
            ra.clear_background(ra.LIGHTGRAY);
            if (current_screen == LOGO) {
                ra.draw_text("LOGO SCREEN", 20, 20, 40, ra.LIGHTGRAY);
                ra.draw_text("WAIT for 2 SECONDS...", 150, 100, 20, ra.GRAY);
            } or (current_screen == TITLE) {
                ra.draw_rectangle(0, 0, sw, sh, ra.GREEN);

                ra.draw_text("TITLE SCREEN", 10, 20, 40, ra.DARKGREEN);
                ra.draw_text("PRESS ENTER or TAP to JUMP to GAMEPLAY SCREEN", 10, 100, 20, ra.DARKGREEN);
            } or (current_screen == GAMEPLAY) {
                ra.draw_rectangle(0, 0, sw, sh, ra.PURPLE);
                ra.draw_text("GAMEPLAY SCREEN", 10, 20, 40, ra.MAROON);
                ra.draw_text("PRESS ENTER or TAP to JUMP to ENDING SCREEN", 10, 100, 20, ra.MAROON);
            } or (current_screen == ENDING) {
                ra.draw_rectangle(0, 0, sw, sh, ra.BLUE);
                ra.draw_text("ENDING SCREEN", 10, 20, 40, ra.DARKBLUE);
                ra.draw_text("PRESS ENTER or TAP to RETURN to TITLE SCREEN", 10, 100, 20, ra.DARKBLUE);
            }
        ra.end_drawing();
    } # -----------------

    # --- DeInit --------
    ra.close_window();
    ret 0;
}

