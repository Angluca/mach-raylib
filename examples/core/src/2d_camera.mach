use std.runtime;

use raylib.ra;
use raylib.ra.Vector2;

val MAX_BUILDINGS: i32 = 100;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    # -- Init -----------
    val sw: i32 = 800;
    val sh: i32 = 450;
    ra.init_window(sw, sh, "2d camera");
    ra.set_target_fps(60);

    var player: ra.Rectangle = ra.Rectangle {x: 400.0, y: 280.0, width: 40.0, height: 40.0};
    var buildings: [MAX_BUILDINGS]ra.Rectangle;
    var build_colors: [MAX_BUILDINGS]ra.Color;
    var spacing: i32 = 0;
    var i: i32 = 0;
    for (i < MAX_BUILDINGS) {
        buildings[i].width = ra.get_random_value(50, 200)::f32;
        buildings[i].height = ra.get_random_value(100, 800)::f32;
        buildings[i].y = sh::f32 - 130.0 - buildings[i].height;
        buildings[i].x = -6000.0 + spacing::f32;
        spacing = spacing + buildings[i].width::i32;
        build_colors[i] = ra.Color {
            r: ra.get_random_value(200, 240)::u8,
            g: ra.get_random_value(200, 240)::u8,
            b: ra.get_random_value(200, 250)::u8, a: 255
        };
        i = i + 1;
    }

    var camera: ra.Camera2D;
    camera.target = Vector2 { x: player.y + 20.0, y: player.y + 20.0 };
    camera.offset = Vector2 { x: sw::f32 / 2.0, y: sh::f32 / 2.0 };
    camera.zoom = 1.0;

    # --- Main loop -----
    for (!ra.window_should_close()) {
        ## -- Update -----
        if (ra.is_key_down(ra.KEY_RIGHT)) { player.x = player.x + 2.0; }
        or (ra.is_key_down(ra.KEY_LEFT)) { player.x = player.x - 2.0; }

        camera.target = Vector2 { x: player.x + 20.0, y: player.y + 20.0 };

        if (ra.is_key_down(ra.KEY_A)) { camera.rotation = camera.rotation + 1.0; }
        or (ra.is_key_down(ra.KEY_D)) { camera.rotation = camera.rotation - 1.0; }

        if (camera.rotation > 40.0) { camera.rotation = 40.0; }
        or (camera.rotation < -40.0) { camera.rotation = -40.0; }

        camera.zoom = ra.expf(ra.logf(camera.zoom) + ra.get_mouse_wheel_move() * 0.1);

        if (camera.zoom > 3.0) { camera.zoom = 3.0; }
        or (camera.zoom < 0.1) { camera.zoom = 0.1; }

        if (ra.is_key_pressed(ra.KEY_R)) {
            camera.zoom = 1.0; camera.rotation = 0.0;
        }

        # -- Draw -------
        ra.begin_drawing();
            ra.clear_background(ra.RAYWHITE);
            ra.begin_mode2d(camera);
                ra.draw_rectangle(-6000, 320, 13000, 8000, ra.DARKGRAY);
                i = 0;
                for (i < MAX_BUILDINGS) {
                    ra.draw_rectangle_rec(buildings[i], build_colors[i]);
                    i = i + 1;
                }
                ra.draw_rectangle_rec(player, ra.RED);
                ra.draw_line(camera.target.x::i32, -sh*10, camera.target.x::i32,
                    sh*10, ra.GREEN);
                ra.draw_line(-sw*10, camera.target.y::i32, sw*10,
                    camera.target.y::i32, ra.GREEN);
            ra.end_mode2d();

            ra.draw_text("SCREEN AREA", 640, 10, 20, ra.RED);
            ra.draw_rectangle(0, 0, sw, 5, ra.RED);
            ra.draw_rectangle(0, 5, 5, sh-10, ra.RED);
            ra.draw_rectangle(sw-5, 5, 5, sh-10, ra.RED);
            ra.draw_rectangle(0, sh-5, sw, 5, ra.RED);

            ra.draw_rectangle(10, 10, 250, 113, ra.fade(ra.SKYBLUE, 0.5));
            ra.draw_rectangle_lines(10, 10, 250, 113, ra.BLUE);

            ra.draw_text("Free 2D camera controls:", 20, 20, 10, ra.BLACK);
            ra.draw_text("- Right/Left to move player", 40, 40, 10, ra.DARKGRAY);
            ra.draw_text("- Mouse Wheel to Zoom in-out", 40, 60, 10, ra.DARKGRAY);
            ra.draw_text("- A / S to Rotate", 40, 80, 10, ra.DARKGRAY);
            ra.draw_text("- R to reset Zoom and Rotation", 40, 100, 10, ra.DARKGRAY);
        ra.end_drawing();
    } # -----------------

    # --- DeInit --------
    ra.close_window();
    ret 0;
}

