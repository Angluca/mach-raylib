use std.runtime;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.result.unwrap_err;
use std.types.string.str;
use raylib.ra;
use raylib.ra.Vector3;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    # -- Init -----------
    val sw: i32 = 600;
    val sh: i32 = 350;
    ra.init_window(sw, sh, "3d picking");
    ra.set_target_fps(60);

    var camera: ra.Camera; # Values default all zero
    camera.position = ra.vector3(10.0, 10.0, 10.0);
    camera.up.y = 1.0;
    camera.fovy = 45.0;
    camera.projection = ra.CAMERA_PERSPECTIVE;

    var cube_pos: Vector3 = ra.vector3(0.0, 1.0, 0.0);
    var cube_size: Vector3 = ra.vector3(2.0, 2.0, 2.0);

    var ray: ra.Ray;
    var collision: ra.RayCollision;

    # --- Main loop -----
    for (!ra.window_should_close()) {
        # -- Update -----
        if (ra.is_cursor_hidden()) {
            ra.update_camera(?camera, ra.CAMERA_FIRST_PERSON);
        }
        if (ra.is_mouse_button_pressed(ra.MOUSE_BUTTON_RIGHT)) {
            if (ra.is_cursor_hidden()) { ra.enable_cursor(); }
            or { ra.disable_cursor(); }
        }
        if (ra.is_mouse_button_pressed(ra.MOUSE_BUTTON_LEFT)) {
            if (!collision.hit) {
                ray = ra.get_screen_to_world_ray(ra.get_mouse_position(), camera);
                collision = ra.get_ray_collision_box(ray, (ra.BoundingBox {
                    min: ra.vector3(cube_pos.x-cube_size.x/2.0,
                        cube_pos.y-cube_size.y/2.0, cube_pos.z-cube_size.z/2.0),
                    max: ra.vector3(cube_pos.x+cube_size.x/2.0,
                        cube_pos.y+cube_size.y/2.0, cube_pos.z+cube_size.z/2.0)}));
            }
            or { collision.hit = false; }
        }
        # -- Draw -------
        ra.begin_drawing();
            ra.clear_background(ra.LIGHTGRAY);
            ra.begin_mode3d(camera);
                if (collision.hit) {
                    ra.draw_cube(cube_pos, cube_size.x, cube_size.y, cube_size.z, ra.RED);
                    ra.draw_cube_wires(cube_pos, cube_size.x, cube_size.y, cube_size.z, ra.MAROON);
                    ra.draw_cube_wires(cube_pos, cube_size.x+0.2, cube_size.y+0.2, cube_size.z+0.2, ra.GREEN);
                }
                or {
                    ra.draw_cube(cube_pos, cube_size.x, cube_size.y, cube_size.z, ra.GREEN);
                    ra.draw_cube_wires(cube_pos, cube_size.x, cube_size.y, cube_size.z, ra.DARKGRAY);
                }
            ra.end_mode3d();
            ra.draw_fps(10, 10);
            ra.draw_text("Try clicking on the box with your mouse!", 90, 10, 20, ra.DARKGRAY);
            ra.draw_text("Right click mouse to toggle camera controls", 50, 30, 20, ra.GRAY);
            if (collision.hit) {
                ra.draw_text("BOX SELECTED", (sw - ra.measure_text("BOX SELECTED", 30))/2, (sh::f32*0.1)::i32+30, 30, ra.PURPLE);
            }
            ra.logo(sw-160, sh-80, 1.0);
        ra.end_drawing();
    } # -----------------
    # --- DeInit --------
    ra.close_window();
    ret 0;
}

