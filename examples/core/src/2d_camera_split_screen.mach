use std.runtime;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.result.unwrap_err;
use std.types.string.str;
use A: std.allocator;
use std.allocator.fixed;
use std.format.sprint;

use raylib.ra;
use rl: raylib.rlgl;
use raylib.ra.Vector2;
use raylib.ra.Rectangle;

var PLAYER_SIZE: i32 = 40;
var MOVE_SPEED: f32 = 3.0;
#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    # -- Init -----------
    val sw: i32 = 800;
    val sh: i32 = 440;
    ra.init_window(sw, sh, "2d camera split screen");
    ra.set_target_fps(60);

    var player1: Rectangle = Rectangle{ x: 200.0, y: 200.0, width:  PLAYER_SIZE::f32, height: PLAYER_SIZE::f32 };
    var player2: Rectangle = Rectangle{ x: 250.0, y: 200.0, width:  PLAYER_SIZE::f32, height: PLAYER_SIZE::f32 };

    var camera1: ra.Camera2D;
    camera1.target = Vector2{ x: player1.x, y: player1.y };
    camera1.offset = Vector2{ x: 200.0, y: 200.0 };
    camera1.rotation = 0.0;
    camera1.zoom = 1.0;
    var camera2: ra.Camera2D;
    camera2.target = Vector2{ x: player2.x, y: player2.y };
    camera2.offset = Vector2{ x: 200.0, y: 200.0 };
    camera2.rotation = 0.0;
    camera2.zoom = 1.0;

    var screen_camera1: ra.RenderTexture = ra.load_render_texture(sw/2, sh);
    var screen_camera2: ra.RenderTexture = ra.load_render_texture(sw/2, sh);
    fin {
        ra.unload_render_texture(screen_camera1);
        ra.unload_render_texture(screen_camera2);
    }

    var split_screen_rect: Rectangle = Rectangle{ x: 0.0, y: 0.0,
        width: screen_camera1.texture.width::f32,
        height: -screen_camera1.texture.height::f32
    };

    #var camera: ra.Camera2D;
    #camera.zoom = 1.0;
    #var zoom_mode: i32 = 0;

    var buf: [256]u8;
    var st: fixed.FixedState;
    var al: A.Allocator;
    fixed.make(?al, ?st, ?buf[0], $size_of(buf));
    var rbuf: Result[str, str];
    var ps: str;

    # --- Main loop -----
    for (!ra.window_should_close()) {
        # -- Update -----
        if (ra.is_key_down(ra.KEY_S)) { player1.y = player1.y + MOVE_SPEED; }
        or (ra.is_key_down(ra.KEY_W)) { player1.y = player1.y - MOVE_SPEED; }
        if (ra.is_key_down(ra.KEY_D)) { player1.x = player1.x + MOVE_SPEED; }
        or (ra.is_key_down(ra.KEY_A)) { player1.x = player1.x - MOVE_SPEED; }
        player2.x = ra.get_mouse_x()::f32;
        player2.y = ra.get_mouse_y()::f32;

        camera1.target = Vector2{ x: player1.x, y: player1.y };
        camera2.target = Vector2{ x: player2.x, y: player2.y };

        # -- Draw -------
        # - PLAYER1 -
        var i: i32; var j: i32;
        ra.begin_texture_mode(screen_camera1);
            ra.clear_background(ra.RAYWHITE);
            ra.begin_mode2d(camera1);
                i = 0;
                for (i < sw/PLAYER_SIZE+1) {
                    fin { i = i + 1; }
                    ra.draw_line_v(Vector2{x: (PLAYER_SIZE*i)::f32, y: 0.0}, Vector2{x: (PLAYER_SIZE*i)::f32, y: sh::f32}, ra.LIGHTGRAY);
                } i = 0;
                for (i < sh/PLAYER_SIZE+1) {
                    fin { i = i + 1; }
                    ra.draw_line_v(Vector2{x: 0.0, y: (PLAYER_SIZE*i)::f32}, Vector2{x: sw::f32, y: (PLAYER_SIZE*i)::f32}, ra.LIGHTGRAY);
                } i = 0;
                for (i < sw/PLAYER_SIZE) {
                    fin { i = i + 1; }
                    j = 0;
                    for (j < sh/PLAYER_SIZE) {
                        fin { j = j + 1; }
                        fixed.reset(?st);
                        rbuf = sprint(?al, "[{}, {}]", i, j);
                        ps = unwrap_ok[str, str](rbuf);
                        ra.draw_text(ps, 10+PLAYER_SIZE*i, 15+PLAYER_SIZE*j, 10, ra.LIGHTGRAY);
                    }
                }
                ra.draw_rectangle_rec(player1, ra.RED);
                ra.draw_rectangle_rec(player2, ra.BLUE);
            ra.end_mode2d();

            ra.draw_rectangle(0, 0, ra.get_screen_width()/2, 30, ra.fade(ra.LIGHTGRAY, 0.6f));
            ra.draw_text("PLAYER1: W/S/A/D to move", 10, 10, 10, ra.MAROON);
        ra.end_texture_mode();

        # - PLAYER2 -
        ra.begin_texture_mode(screen_camera2);
            ra.clear_background(ra.RAYWHITE);
            ra.begin_mode2d(camera2);
                i = 0; j = 0;
                for (i < sw/PLAYER_SIZE+1) {
                    fin { i = i + 1; }
                    ra.draw_line_v(Vector2{x: (PLAYER_SIZE*i)::f32, y: 0.0}, Vector2{x: (PLAYER_SIZE*i)::f32, y: sh::f32}, ra.LIGHTGRAY);
                } i = 0;
                for (i < sh/PLAYER_SIZE+1) {
                    fin { i = i + 1; }
                    ra.draw_line_v(Vector2{x: 0.0, y: (PLAYER_SIZE*i)::f32}, Vector2{x: sw::f32, y: (PLAYER_SIZE*i)::f32}, ra.LIGHTGRAY);
                } i = 0;
                for (i < sw/PLAYER_SIZE ) {
                    fin { i = i + 1; }
                    j = 0;
                    for (j < sh/PLAYER_SIZE) {
                        fin { j = j + 1; }
                        fixed.reset(?st);
                        rbuf = sprint(?al, "[{}, {}]", i, j);
                        ps = unwrap_ok[str, str](rbuf);
                        ra.draw_text(ps, 10+PLAYER_SIZE*i, 15+PLAYER_SIZE*j, 10, ra.LIGHTGRAY);
                    }
                }
                ra.draw_rectangle_rec(player1, ra.RED);
                ra.draw_rectangle_rec(player2, ra.BLUE);
            ra.end_mode2d();

            ra.draw_rectangle(0, 0, ra.get_screen_width()/2, 30, ra.fade(ra.LIGHTGRAY, 0.6f));
            ra.draw_text("PLAYER2: Mouse to move", 10, 10, 10, ra.DARKBLUE);
        ra.end_texture_mode();

        # Draw all to screen
        ra.begin_drawing();
            ra.clear_background(ra.BLACK);
            ra.draw_texture_rec(screen_camera1.texture, split_screen_rect, Vector2{x: 0.0, y: 0.0}, ra.WHITE);
            ra.draw_texture_rec(screen_camera2.texture, split_screen_rect, Vector2{x: sw::f32/2.0, y: 0.0}, ra.WHITE);
            ra.draw_rectangle(ra.get_screen_width()/2-2, 0, 4, ra.get_screen_width(), ra.LIGHTGRAY);
            ra.logo(sw-160, sh-80, 1.0);
        ra.end_drawing();
    } # -----------------

    # --- DeInit --------
    ra.close_window();
    ret 0;
}

