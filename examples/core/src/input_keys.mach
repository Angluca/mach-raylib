use std.runtime;
use ra: raylib.raylib;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    # -- Init -----------
    val sw: i32 = 600;
    val sh: i32 = 200;
    ra.init_window(sw, sh, "input keys");
    ra.set_target_fps(60);

    var ball_position: ra.Vector2 = ra.Vector2 { x: sw::f32/2.0, y: sh::f32/2.0 };

    # --- Main loop -----
    for (!ra.window_should_close()) {
        # -- Update -----
        if (ra.is_key_down(ra.KEY_D)) { ball_position.x = ball_position.x + 2.0; }
        or (ra.is_key_down(ra.KEY_A)) { ball_position.x = ball_position.x - 2.0; }
        if (ra.is_key_down(ra.KEY_S)) { ball_position.y = ball_position.y + 2.0; }
        or (ra.is_key_down(ra.KEY_W)) { ball_position.y = ball_position.y - 2.0; }

        # -- Draw -------
        ra.begin_drawing();
            ra.clear_background(ra.LIGHTGRAY);
            ra.draw_text("move the ball with A S W D keys", 10, 10, 20, ra.DARKGRAY);
            ra.draw_circle_v(ball_position, 50.0, ra.MAROON);
        ra.end_drawing();
    } # -----------------

    # --- DeInit --------
    ra.close_window();
    ret 0;
}

