use std.runtime;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.string.str;
use raylib.ra;  # ra is composed of raylib/raymath/rcamera

val MAX_COLUMNS: i32 = 20;
#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    # -- Init -----------
    val sw: i32 = 600;
    val sh: i32 = 350;
    ra.init_window(sw, sh, "3d camera first person");
    ra.set_target_fps(60);

    var camera: ra.Camera;
    camera.position = ra.Vector3 { x: 0.0, y: 2.0, z: 3.0 };
    camera.target = ra.Vector3 { x: 0.0, y: 2.0, z: 0.0 };
    camera.up = ra.vector3(0.0, 1.0, 0.0);
    camera.fovy = 60.0;
    camera.projection = ra.CAMERA_PERSPECTIVE;

    var camera_mode: i32 = ra.CAMERA_FIRST_PERSON;

    var heights: [MAX_COLUMNS]f32;
    var positions: [MAX_COLUMNS]ra.Vector3;
    var colors: [MAX_COLUMNS]ra.Color;

    var i: i32;
    for (i < MAX_COLUMNS) {
        heights[i] = ra.get_random_value(1, 12)::f32;
        positions[i] = ra.Vector3 { x:ra.get_random_value(-15, 15)::f32,
            y: heights[i]/2.0, z: ra.get_random_value(-15, 15)::f32 };
        colors[i] = ra.Color { r: ra.get_random_value(20, 255)::u8,
            g: ra.get_random_value(10, 255)::u8, b: 30, a: 255 };
        i = i + 1;
    }
    ra.disable_cursor();

    # --- Main loop -----
    for (!ra.window_should_close()) {
        # -- Update -----
        if ( ra.is_key_pressed(ra.KEY_ONE) ) {
            camera_mode = ra.CAMERA_FREE;
            camera.up = ra.Vector3 { x: 0.0, y: 1.0, z: 0.0 };
        }

        if ( ra.is_key_pressed(ra.KEY_TWO) ) {
            camera_mode = ra.CAMERA_FIRST_PERSON;
            camera.up = ra.Vector3 { x: 0.0, y: 1.0, z: 0.0 };
        }

        if ( ra.is_key_pressed(ra.KEY_THREE) ) {
            camera_mode = ra.CAMERA_THIRD_PERSON;
            camera.up = ra.Vector3 { x: 0.0, y: 1.0, z: 0.0 };
        }

        if ( ra.is_key_pressed(ra.KEY_FOUR) ) {
            camera_mode = ra.CAMERA_ORBITAL;
            camera.up = ra.Vector3 { x: 0.0, y: 1.0, z: 0.0 };
        }

        if (ra.is_key_pressed(ra.KEY_SPACE)) {
            if (camera.projection == ra.CAMERA_PERSPECTIVE) {
                camera_mode = ra.CAMERA_THIRD_PERSON;
                camera.position = ra.Vector3 { x: 0.0, y: 2.0, z: -100.0 };
                camera.target = ra.Vector3 { x: 0.0, y: 2.0, z: 0.0 };
                camera.up = ra.Vector3 { x: 0.0, y: 1.0, z: 0.0 };
                camera.projection = ra.CAMERA_ORTHOGRAPHIC;
                camera.fovy = 20.0;

                ra.camera_yaw(?camera, -135::f32 * ra.DEG2RAD, true);
                ra.camera_pitch(?camera, -45::f32 * ra.DEG2RAD, true, true, false);
            }
            or (camera.projection == ra.CAMERA_ORTHOGRAPHIC) {
                camera_mode = ra.CAMERA_THIRD_PERSON;
                camera.position = ra.Vector3 { x: 0.0, y: 2.0, z: 10.0 };
                camera.target = ra.Vector3 { x: 0.0, y: 2.0, z: 0.0 };
                camera.up = ra.Vector3 { x: 0.0, y: 1.0, z: 0.0 };
                camera.projection = ra.CAMERA_PERSPECTIVE;
                camera.fovy = 60.0;
            }
        }

        ra.update_camera(?camera, camera_mode);

        # -- Draw -------
        ra.begin_drawing();
            ra.clear_background(ra.LIGHTGRAY);
            ra.begin_mode3d(camera);
                ra.draw_plane(ra.vector3 (0.0, 0.0, 0.0),
                    ra.vector2(32.0, 32.0), ra.LIGHTGRAY);
                ra.draw_cube(ra.vector3(-16.0, 2.5, 0.0), 1.0, 5.0, 32.0,
                    ra.BLUE);
                ra.draw_cube(ra.vector3(16.0, 2.5, 0.0), 1.0, 5.0, 32.0,
                    ra.LIME);
                ra.draw_cube(ra.vector3(0.0, 2.5, 16.0), 32.0, 5.0, 1.0,
                    ra.GOLD);
                if (camera_mode == ra.CAMERA_THIRD_PERSON) {
                    ra.draw_cube(camera.target, 0.5, 0.5, 0.5, ra.PURPLE);
                    ra.draw_cube_wires(camera.target, 0.5, 0.5, 0.5, ra.DARKPURPLE);
                }
            ra.end_mode3d();

            ra.draw_rectangle(5, 5, 330, 100, ra.fade(ra.SKYBLUE, 0.5));
            ra.draw_rectangle_lines(5, 5, 330, 100, ra.BLUE);

            ra.draw_text("Camera controls:", 15, 15, 10, ra.BLACK);
            ra.draw_text("- Move keys: W/A/S/D", 15, 30, 10, ra.BLACK);
            ra.draw_text("- Look around: arrow keys or mouse", 15, 45, 10, ra.BLACK);
            ra.draw_text("- Camera mode keys: 1,2,3,4", 15, 60, 10, ra.BLACK);
            ra.draw_text("- Zoom keys: num-plus, num-minus or mouse scroll", 15, 75, 10, ra.BLACK);
            ra.draw_text("- Camera projection key: Space", 15, 90, 10, ra.BLACK);

            ra.draw_rectangle(600, 5, 195, 100, ra.fade(ra.SKYBLUE, 0.5));
            ra.draw_rectangle_lines(600, 5, 330, 100, ra.BLUE);
            ra.draw_text("Camera status:", 610, 15, 10, ra.BLACK);
            var s: str;
            if (camera_mode == ra.CAMERA_FREE) { s = "FREE"; }
            or (camera_mode == ra.CAMERA_FIRST_PERSON) { s = "FIRST_PERSON"; }
            or (camera_mode == ra.CAMERA_THIRD_PERSON) { s = "THIRD_PERSON"; }
            or (camera_mode == ra.CAMERA_ORBITAL) { s = "ORBITAL"; }
            or { s = "CUSTOM"; }
            ra.draw_text(ra.text_format("- Mode: %s", s), 410, 30, 10, ra.BLACK);
            if (camera.projection == ra.CAMERA_PERSPECTIVE) { s = "PERSPECTIVE"; }
            or (camera.projection == ra.CAMERA_ORTHOGRAPHIC) { s = "ORTHOGRAPHIC"; }
            or { s = "CUSTOM"; }
            ra.draw_text(ra.text_format("- Projection: %s", s), 410, 45, 10, ra.BLACK);
            ra.draw_text(ra.text_format(
                "- Position: (%06.3f, %06.3f, %06.3f)",
                camera.position.x::f64, camera.position.y::f64,
                camera.position.z::f64), 410, 60, 10, ra.BLACK);
            ra.draw_text(ra.text_format(
                "- Target: (%06.3f, %06.3f, %06.3f)",
                camera.target.x::f64, camera.target.y::f64,
                camera.target.z::f64), 410, 75, 10, ra.BLACK);
            ra.draw_text(ra.text_format(
                "- Up: (%06.3f, %06.3f, %06.3f)",
                camera.target.x::f64, camera.target.y::f64,
                camera.target.z::f64), 410, 90, 10, ra.BLACK);
            ra.logo(440, 270);
        ra.end_drawing();
    } # -----------------

    # --- DeInit --------
    ra.close_window();
    ret 0;
}

