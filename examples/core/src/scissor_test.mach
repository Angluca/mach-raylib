use std.runtime;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use raylib.ra;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    # -- Init -----------
    val sw: i32 = 600;
    val sh: i32 = 260;
    ra.init_window(sw, sh, "scissor test");
    ra.set_target_fps(60);

    var scissor_area: ra.Rectangle = ra.Rectangle { x: 50.0, y: 20.0, width: 260.0, height: 150.0 };
    var scissor_mode: bool = true;

    # --- Main loop -----
    for (!ra.window_should_close()) {
        # -- Update -----
        # scissor_arean follow mouse
        scissor_area.x = ra.get_mouse_x()::f32 - scissor_area.width/2.0;
        scissor_area.y = ra.get_mouse_y()::f32 - scissor_area.height/2.0;

        ## -- Draw -------
        ra.begin_drawing();
            ra.clear_background(ra.GRAY);

            if (scissor_mode) {
                ra.begin_scissor_mode(scissor_area.x::i32, scissor_area.y::i32, scissor_area.width::i32, scissor_area.height::i32);
            }
            ra.draw_rectangle(0, 0, ra.get_screen_width(), ra.get_screen_height(), ra.BLUE);
            ra.draw_text("Move the mouse around to reveal this text!", 100, 120, 20, ra.LIGHTGRAY);

            if (scissor_mode) { ra.end_scissor_mode(); }
            ra.draw_rectangle_lines_ex(scissor_area, 1.0, ra.BLACK);
            ra.draw_text("Move mouse scissor test", 10, 10, 20, ra.BLACK);

        ra.end_drawing();
    } # -----------------

    # --- DeInit --------
    ra.close_window();
    ret 0;
}

