fwd std.types.bool.bool;
fwd std.types.bool.true;
fwd std.types.bool.false;
fwd std.types.string.str;

fwd raylib.raylib.Vector2;
fwd raylib.raylib.Vector3;
fwd raylib.raylib.Matrix;
fwd raylib.raylib.Camera3D;

pub val CAMERA_CULL_DISTANCE_NEAR: f64 = 0.05;
pub val CAMERA_CULL_DISTANCE_FAR: f64 = 4000.0;
pub val CAMERA_MOVE_SPEED: f32 = 5.4;
pub val CAMERA_ROTATION_SPEED: f32 = 0.03;
pub val CAMERA_PAN_SPEED: f32 = 2.0;
pub val CAMERA_MOUSE_MOVE_SENSITIVITY: f32 = 0.003;
pub val CAMERA_ORBITAL_SPEED: f32 = 0.5;
pub def Camera: Camera3D;
pub val CAMERA_PERSPECTIVE: i32 = 0;
pub val CAMERA_ORTHOGRAPHIC: i32 = 1;
pub val CAMERA_CUSTOM: i32 = 0;
pub val CAMERA_FREE: i32 = 1;
pub val CAMERA_ORBITAL: i32 = 2;
pub val CAMERA_FIRST_PERSON: i32 = 3;
pub val CAMERA_THIRD_PERSON: i32 = 4;
#[library("raylib")]
ext fun GetCameraForward(camera: *Camera) Vector3;
pub fun get_camera_forward(camera: *Camera) Vector3 { ret GetCameraForward(camera); }
#[library("raylib")]
ext fun GetCameraUp(camera: *Camera) Vector3;
pub fun get_camera_up(camera: *Camera) Vector3 { ret GetCameraUp(camera); }
#[library("raylib")]
ext fun GetCameraRight(camera: *Camera) Vector3;
pub fun get_camera_right(camera: *Camera) Vector3 { ret GetCameraRight(camera); }
#[library("raylib")]
ext fun CameraMoveForward(camera: *Camera, distance: f32, moveInWorldPlane: bool);
pub fun camera_move_forward(camera: *Camera, distance: f32, moveInWorldPlane: bool) { CameraMoveForward(camera, distance, moveInWorldPlane); }
#[library("raylib")]
ext fun CameraMoveUp(camera: *Camera, distance: f32);
pub fun camera_move_up(camera: *Camera, distance: f32) { CameraMoveUp(camera, distance); }
#[library("raylib")]
ext fun CameraMoveRight(camera: *Camera, distance: f32, moveInWorldPlane: bool);
pub fun camera_move_right(camera: *Camera, distance: f32, moveInWorldPlane: bool) { CameraMoveRight(camera, distance, moveInWorldPlane); }
#[library("raylib")]
ext fun CameraMoveToTarget(camera: *Camera, delta: f32);
pub fun camera_move_to_target(camera: *Camera, delta: f32) { CameraMoveToTarget(camera, delta); }
#[library("raylib")]
ext fun CameraYaw(camera: *Camera, angle: f32, rotateAroundTarget: bool);
pub fun camera_yaw(camera: *Camera, angle: f32, rotateAroundTarget: bool) { CameraYaw(camera, angle, rotateAroundTarget); }
#[library("raylib")]
ext fun CameraPitch(camera: *Camera, angle: f32, lockView: bool, rotateAroundTarget: bool, rotateUp: bool);
pub fun camera_pitch(camera: *Camera, angle: f32, lockView: bool, rotateAroundTarget: bool, rotateUp: bool) { CameraPitch(camera, angle, lockView, rotateAroundTarget, rotateUp); }
#[library("raylib")]
ext fun CameraRoll(camera: *Camera, angle: f32);
pub fun camera_roll(camera: *Camera, angle: f32) { CameraRoll(camera, angle); }
#[library("raylib")]
ext fun GetCameraViewMatrix(camera: *Camera) Matrix;
pub fun get_camera_view_matrix(camera: *Camera) Matrix { ret GetCameraViewMatrix(camera); }
#[library("raylib")]
ext fun GetCameraProjectionMatrix(camera: *Camera, aspect: f32) Matrix;
pub fun get_camera_projection_matrix(camera: *Camera, aspect: f32) Matrix { ret GetCameraProjectionMatrix(camera, aspect); }
