fwd std.types.bool.bool;
fwd std.types.bool.true;
fwd std.types.bool.false;
fwd std.types.string.str;

pub val CAMERA_CULL_DISTANCE_NEAR: f64 = 0.05;
pub val CAMERA_CULL_DISTANCE_FAR: f64 = 4000.0;
pub val CAMERA_MOVE_SPEED: f32 = 5.4;
pub val CAMERA_ROTATION_SPEED: f32 = 0.03;
pub val CAMERA_PAN_SPEED: f32 = 2.0;
pub val CAMERA_MOUSE_MOVE_SENSITIVITY: f32 = 0.003;
pub val CAMERA_ORBITAL_SPEED: f32 = 0.5;
pub rec Vector2 {
      x: f32;
      y: f32;
}
pub rec Vector3 {
      x: f32;
      y: f32;
      z: f32;
}
pub rec Matrix {
      m0: f32;
      m4: f32;
      m8: f32;
      m12: f32;
      m1: f32;
      m5: f32;
      m9: f32;
      m13: f32;
      m2: f32;
      m6: f32;
      m10: f32;
      m14: f32;
      m3: f32;
      m7: f32;
      m11: f32;
      m15: f32;
}
pub rec Camera3D {
      position: Vector3;
      target: Vector3;
      up: Vector3;
      fovy: f32;
      projection: i32;
}
pub def Camera: Camera3D;
pub val CAMERA_PERSPECTIVE: i32 = 0;
pub val CAMERA_ORTHOGRAPHIC: i32 = 1;
pub val CAMERA_CUSTOM: i32 = 0;
pub val CAMERA_FREE: i32 = 1;
pub val CAMERA_ORBITAL: i32 = 2;
pub val CAMERA_FIRST_PERSON: i32 = 3;
pub val CAMERA_THIRD_PERSON: i32 = 4;
#[library("raylib")]
ext fun GetCameraForward(camera: *Camera) Vector3;
pub fun get_camera_forward(camera: *Camera) Vector3 { ret GetCameraForward(camera); }
#[library("raylib")]
ext fun GetCameraUp(camera: *Camera) Vector3;
pub fun get_camera_up(camera: *Camera) Vector3 { ret GetCameraUp(camera); }
#[library("raylib")]
ext fun GetCameraRight(camera: *Camera) Vector3;
pub fun get_camera_right(camera: *Camera) Vector3 { ret GetCameraRight(camera); }
#[library("raylib")]
ext fun CameraMoveForward(camera: *Camera, distance: f32, moveInWorldPlane: bool) u8;
pub fun camera_move_forward(camera: *Camera, distance: f32, moveInWorldPlane: bool) u8 { ret CameraMoveForward(camera, distance, moveInWorldPlane); }
#[library("raylib")]
ext fun CameraMoveUp(camera: *Camera, distance: f32) u8;
pub fun camera_move_up(camera: *Camera, distance: f32) u8 { ret CameraMoveUp(camera, distance); }
#[library("raylib")]
ext fun CameraMoveRight(camera: *Camera, distance: f32, moveInWorldPlane: bool) u8;
pub fun camera_move_right(camera: *Camera, distance: f32, moveInWorldPlane: bool) u8 { ret CameraMoveRight(camera, distance, moveInWorldPlane); }
#[library("raylib")]
ext fun CameraMoveToTarget(camera: *Camera, delta: f32) u8;
pub fun camera_move_to_target(camera: *Camera, delta: f32) u8 { ret CameraMoveToTarget(camera, delta); }
#[library("raylib")]
ext fun CameraYaw(camera: *Camera, angle: f32, rotateAroundTarget: bool) u8;
pub fun camera_yaw(camera: *Camera, angle: f32, rotateAroundTarget: bool) u8 { ret CameraYaw(camera, angle, rotateAroundTarget); }
#[library("raylib")]
ext fun CameraPitch(camera: *Camera, angle: f32, lockView: bool, rotateAroundTarget: bool, rotateUp: bool) u8;
pub fun camera_pitch(camera: *Camera, angle: f32, lockView: bool, rotateAroundTarget: bool, rotateUp: bool) u8 { ret CameraPitch(camera, angle, lockView, rotateAroundTarget, rotateUp); }
#[library("raylib")]
ext fun CameraRoll(camera: *Camera, angle: f32) u8;
pub fun camera_roll(camera: *Camera, angle: f32) u8 { ret CameraRoll(camera, angle); }
#[library("raylib")]
ext fun GetCameraViewMatrix(camera: *Camera) Matrix;
pub fun get_camera_view_matrix(camera: *Camera) Matrix { ret GetCameraViewMatrix(camera); }
#[library("raylib")]
ext fun GetCameraProjectionMatrix(camera: *Camera, aspect: f32) Matrix;
pub fun get_camera_projection_matrix(camera: *Camera, aspect: f32) Matrix { ret GetCameraProjectionMatrix(camera, aspect); }
