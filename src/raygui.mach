#[library("raygui")]
ext fun GuiEnable();
pub fun enable() { GuiEnable(); }
#[library("raygui")]
ext fun GuiDisable();
pub fun disable() { GuiDisable(); }
#[library("raygui")]
ext fun GuiLock();
pub fun lock() { GuiLock(); }
#[library("raygui")]
ext fun GuiUnlock();
pub fun unlock() { GuiUnlock(); }
#[library("raygui")]
ext fun GuiIsLocked() bool;
pub fun is_locked() bool { ret GuiIsLocked(); }
#[library("raygui")]
ext fun GuiSetAlpha(alpha: f32);
pub fun set_alpha(alpha: f32) { GuiSetAlpha(alpha); }
#[library("raygui")]
ext fun GuiSetState(state: i32);
pub fun set_state(state: i32) { GuiSetState(state); }
#[library("raygui")]
ext fun GuiGetState() i32;
pub fun get_state() i32 { ret GuiGetState(); }
#[library("raygui")]
ext fun GuiSetFont(font: Font);
pub fun set_font(font: Font) { GuiSetFont(font); }
#[library("raygui")]
ext fun GuiGetFont() Font;
pub fun get_font() Font { ret GuiGetFont(); }
#[library("raygui")]
ext fun GuiSetStyle(control: i32, property: i32, value: i32);
pub fun set_style(control: i32, property: i32, value: i32) { GuiSetStyle(control, property, value); }
#[library("raygui")]
ext fun GuiGetStyle(control: i32, property: i32) i32;
pub fun get_style(control: i32, property: i32) i32 { ret GuiGetStyle(control, property); }
#[library("raygui")]
ext fun GuiLoadStyle(fileName: str);
pub fun load_style(fileName: str) { GuiLoadStyle(fileName); }
#[library("raygui")]
ext fun GuiLoadStyleFromMemory(fileData: *u8, dataSize: i32);
pub fun load_style_from_memory(fileData: *u8, dataSize: i32) { GuiLoadStyleFromMemory(fileData, dataSize); }
#[library("raygui")]
ext fun GuiLoadStyleDefault();
pub fun load_style_default() { GuiLoadStyleDefault(); }
#[library("raygui")]
ext fun GuiEnableTooltip();
pub fun enable_tooltip() { GuiEnableTooltip(); }
#[library("raygui")]
ext fun GuiDisableTooltip();
pub fun disable_tooltip() { GuiDisableTooltip(); }
#[library("raygui")]
ext fun GuiSetTooltip(tooltip: str);
pub fun set_tooltip(tooltip: str) { GuiSetTooltip(tooltip); }
#[library("raygui")]
ext fun GuiIconText(iconId: i32, text: str) str;
pub fun icon_text(iconId: i32, text: str) str { ret GuiIconText(iconId, text); }
#[library("raygui")]
ext fun GuiSetIconScale(scale: i32);
pub fun set_icon_scale(scale: i32) { GuiSetIconScale(scale); }
#[library("raygui")]
ext fun GuiGetIcons() *u32;
pub fun get_icons() *u32 { ret GuiGetIcons(); }
#[library("raygui")]
ext fun GuiLoadIcons(fileName: str, loadIconsName: bool) *str;
pub fun load_icons(fileName: str, loadIconsName: bool) *str { ret GuiLoadIcons(fileName, loadIconsName); }
#[library("raygui")]
ext fun GuiLoadIconsFromMemory(fileData: *u8, dataSize: i32, loadIconsName: bool) *str;
pub fun load_icons_from_memory(fileData: *u8, dataSize: i32, loadIconsName: bool) *str { ret GuiLoadIconsFromMemory(fileData, dataSize, loadIconsName); }
#[library("raygui")]
ext fun GuiDrawIcon(iconId: i32, posX: i32, posY: i32, pixelSize: i32, color: Color);
pub fun draw_icon(iconId: i32, posX: i32, posY: i32, pixelSize: i32, color: Color) { GuiDrawIcon(iconId, posX, posY, pixelSize, color); }
#[library("raygui")]
ext fun GuiGetTextWidth(text: str) i32;
pub fun get_text_width(text: str) i32 { ret GuiGetTextWidth(text); }
#[library("raygui")]
ext fun GuiWindowBox(bounds: Rectangle, title: str) i32;
pub fun window_box(bounds: Rectangle, title: str) i32 { ret GuiWindowBox(bounds, title); }
#[library("raygui")]
ext fun GuiGroupBox(bounds: Rectangle, text: str) i32;
pub fun group_box(bounds: Rectangle, text: str) i32 { ret GuiGroupBox(bounds, text); }
#[library("raygui")]
ext fun GuiLine(bounds: Rectangle, text: str) i32;
pub fun line(bounds: Rectangle, text: str) i32 { ret GuiLine(bounds, text); }
#[library("raygui")]
ext fun GuiPanel(bounds: Rectangle, text: str) i32;
pub fun panel(bounds: Rectangle, text: str) i32 { ret GuiPanel(bounds, text); }
#[library("raygui")]
ext fun GuiScrollPanel(bounds: Rectangle, text: str, content: Rectangle, scroll: *Vector2, view: *Rectangle) i32;
pub fun scroll_panel(bounds: Rectangle, text: str, content: Rectangle, scroll: *Vector2, view: *Rectangle) i32 { ret GuiScrollPanel(bounds, text, content, scroll, view); }
#[library("raygui")]
ext fun GuiLabel(bounds: Rectangle, text: str) i32;
