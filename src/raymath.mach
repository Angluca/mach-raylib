pub fun matrix_ortho(left: f64, right: f64, bottom: f64, top: f64, nearPlane: f64, farPlane: f64) Matrix { ret MatrixOrtho(left, right, bottom, top, nearPlane, farPlane); }
#[library("raylib")]
ext fun MatrixLookAt(eye: Vector3, target: Vector3, up: Vector3) Matrix;
pub fun matrix_look_at(eye: Vector3, target: Vector3, up: Vector3) Matrix { ret MatrixLookAt(eye, target, up); }
#[library("raylib")]
ext fun MatrixToFloatV(mat: Matrix) float16;
pub fun matrix_to_float_v(mat: Matrix) float16 { ret MatrixToFloatV(mat); }
#[library("raylib")]
ext fun QuaternionAdd(q1: Quaternion, q2: Quaternion) Quaternion;
pub fun quaternion_add(q1: Quaternion, q2: Quaternion) Quaternion { ret QuaternionAdd(q1, q2); }
#[library("raylib")]
ext fun QuaternionAddValue(q: Quaternion, add: f32) Quaternion;
pub fun quaternion_add_value(q: Quaternion, add: f32) Quaternion { ret QuaternionAddValue(q, add); }
#[library("raylib")]
ext fun QuaternionSubtract(q1: Quaternion, q2: Quaternion) Quaternion;
pub fun quaternion_subtract(q1: Quaternion, q2: Quaternion) Quaternion { ret QuaternionSubtract(q1, q2); }
#[library("raylib")]
ext fun QuaternionSubtractValue(q: Quaternion, sub: f32) Quaternion;
pub fun quaternion_subtract_value(q: Quaternion, sub: f32) Quaternion { ret QuaternionSubtractValue(q, sub); }
#[library("raylib")]
ext fun QuaternionIdentity() Quaternion;
pub fun quaternion_identity() Quaternion { ret QuaternionIdentity(); }
#[library("raylib")]
ext fun QuaternionLength(q: Quaternion) f32;
pub fun quaternion_length(q: Quaternion) f32 { ret QuaternionLength(q); }
#[library("raylib")]
ext fun QuaternionNormalize(q: Quaternion) Quaternion;
pub fun quaternion_normalize(q: Quaternion) Quaternion { ret QuaternionNormalize(q); }
#[library("raylib")]
ext fun QuaternionInvert(q: Quaternion) Quaternion;
pub fun quaternion_invert(q: Quaternion) Quaternion { ret QuaternionInvert(q); }
#[library("raylib")]
ext fun QuaternionMultiply(q1: Quaternion, q2: Quaternion) Quaternion;
pub fun quaternion_multiply(q1: Quaternion, q2: Quaternion) Quaternion { ret QuaternionMultiply(q1, q2); }
#[library("raylib")]
ext fun QuaternionScale(q: Quaternion, mul: f32) Quaternion;
pub fun quaternion_scale(q: Quaternion, mul: f32) Quaternion { ret QuaternionScale(q, mul); }
#[library("raylib")]
ext fun QuaternionDivide(q1: Quaternion, q2: Quaternion) Quaternion;
pub fun quaternion_divide(q1: Quaternion, q2: Quaternion) Quaternion { ret QuaternionDivide(q1, q2); }
#[library("raylib")]
ext fun QuaternionLerp(q1: Quaternion, q2: Quaternion, amount: f32) Quaternion;
pub fun quaternion_lerp(q1: Quaternion, q2: Quaternion, amount: f32) Quaternion { ret QuaternionLerp(q1, q2, amount); }
#[library("raylib")]
ext fun QuaternionNlerp(q1: Quaternion, q2: Quaternion, amount: f32) Quaternion;
pub fun quaternion_nlerp(q1: Quaternion, q2: Quaternion, amount: f32) Quaternion { ret QuaternionNlerp(q1, q2, amount); }
#[library("raylib")]
ext fun QuaternionSlerp(q1: Quaternion, q2: Quaternion, amount: f32) Quaternion;
pub fun quaternion_slerp(q1: Quaternion, q2: Quaternion, amount: f32) Quaternion { ret QuaternionSlerp(q1, q2, amount); }
#[library("raylib")]
ext fun QuaternionCubicHermiteSpline(q1: Quaternion, outTangent1: Quaternion, q2: Quaternion, inTangent2: Quaternion, t: f32) Quaternion;
pub fun quaternion_cubic_hermite_spline(q1: Quaternion, outTangent1: Quaternion, q2: Quaternion, inTangent2: Quaternion, t: f32) Quaternion { ret QuaternionCubicHermiteSpline(q1, outTangent1, q2, inTangent2, t); }
#[library("raylib")]
ext fun QuaternionFromVector3ToVector3(from: Vector3, to: Vector3) Quaternion;
pub fun quaternion_from_vector3_to_vector3(from: Vector3, to: Vector3) Quaternion { ret QuaternionFromVector3ToVector3(from, to); }
#[library("raylib")]
ext fun QuaternionFromMatrix(mat: Matrix) Quaternion;
pub fun quaternion_from_matrix(mat: Matrix) Quaternion { ret QuaternionFromMatrix(mat); }
#[library("raylib")]
ext fun QuaternionToMatrix(q: Quaternion) Matrix;
pub fun quaternion_to_matrix(q: Quaternion) Matrix { ret QuaternionToMatrix(q); }
#[library("raylib")]
ext fun QuaternionFromAxisAngle(axis: Vector3, angle: f32) Quaternion;
pub fun quaternion_from_axis_angle(axis: Vector3, angle: f32) Quaternion { ret QuaternionFromAxisAngle(axis, angle); }
#[library("raylib")]
ext fun QuaternionToAxisAngle(q: Quaternion, outAxis: *Vector3, outAngle: *f32);
pub fun quaternion_to_axis_angle(q: Quaternion, outAxis: *Vector3, outAngle: *f32) { QuaternionToAxisAngle(q, outAxis, outAngle); }
#[library("raylib")]
ext fun QuaternionFromEuler(pitch: f32, yaw: f32, roll: f32) Quaternion;
pub fun quaternion_from_euler(pitch: f32, yaw: f32, roll: f32) Quaternion { ret QuaternionFromEuler(pitch, yaw, roll); }
#[library("raylib")]
ext fun QuaternionToEuler(q: Quaternion) Vector3;
pub fun quaternion_to_euler(q: Quaternion) Vector3 { ret QuaternionToEuler(q); }
#[library("raylib")]
ext fun QuaternionTransform(q: Quaternion, mat: Matrix) Quaternion;
pub fun quaternion_transform(q: Quaternion, mat: Matrix) Quaternion { ret QuaternionTransform(q, mat); }
#[library("raylib")]
ext fun QuaternionEquals(p: Quaternion, q: Quaternion) i32;
pub fun quaternion_equals(p: Quaternion, q: Quaternion) i32 { ret QuaternionEquals(p, q); }
#[library("raylib")]
ext fun MatrixCompose(translation: Vector3, rotation: Quaternion, scale: Vector3) Matrix;
pub fun matrix_compose(translation: Vector3, rotation: Quaternion, scale: Vector3) Matrix { ret MatrixCompose(translation, rotation, scale); }
#[library("raylib")]
ext fun MatrixDecompose(mat: Matrix, translation: *Vector3, rotation: *Quaternion, scale: *Vector3);
pub fun matrix_decompose(mat: Matrix, translation: *Vector3, rotation: *Quaternion, scale: *Vector3) { MatrixDecompose(mat, translation, rotation, scale); }
