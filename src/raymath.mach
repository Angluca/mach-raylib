pub val PI: f32 = 3.14159265358979323846;
pub val EPSILON: f32 = 0.000001;
pub val DEG2RAD: f32 = (PI/180.0f);
pub val RAD2DEG: f32 = (180.0f/PI);
pub rec Vector2 {
      x: f32;
      y: f32;
}
pub rec Vector3 {
      x: f32;
      y: f32;
      z: f32;
}
pub rec Vector4 {
      x: f32;
      y: f32;
      z: f32;
      w: f32;
}
pub rec Matrix {
      m0: f32;
      m4: f32;
      m8: f32;
      m12: f32;
      m1: f32;
      m5: f32;
      m9: f32;
      m13: f32;
      m2: f32;
      m6: f32;
      m10: f32;
      m14: f32;
      m3: f32;
      m7: f32;
      m11: f32;
      m15: f32;
}
pub rec float3 {
      v: [3]f32;
}
pub rec float16 {
      v: [16]f32;
}
