#[library("raylib")]
ext fun IsAudioStreamValid(stream: AudioStream) bool;
pub fun is_audio_stream_valid(stream: AudioStream) bool { ret IsAudioStreamValid(stream); }
#[library("raylib")]
ext fun UnloadAudioStream(stream: AudioStream);
pub fun unload_audio_stream(stream: AudioStream) { UnloadAudioStream(stream); }
#[library("raylib")]
ext fun UpdateAudioStream(stream: AudioStream, data: ptr, frameCount: i32);
pub fun update_audio_stream(stream: AudioStream, data: ptr, frameCount: i32) { UpdateAudioStream(stream, data, frameCount); }
#[library("raylib")]
ext fun IsAudioStreamProcessed(stream: AudioStream) bool;
pub fun is_audio_stream_processed(stream: AudioStream) bool { ret IsAudioStreamProcessed(stream); }
#[library("raylib")]
ext fun PlayAudioStream(stream: AudioStream);
pub fun play_audio_stream(stream: AudioStream) { PlayAudioStream(stream); }
#[library("raylib")]
ext fun PauseAudioStream(stream: AudioStream);
pub fun pause_audio_stream(stream: AudioStream) { PauseAudioStream(stream); }
#[library("raylib")]
ext fun ResumeAudioStream(stream: AudioStream);
pub fun resume_audio_stream(stream: AudioStream) { ResumeAudioStream(stream); }
#[library("raylib")]
ext fun IsAudioStreamPlaying(stream: AudioStream) bool;
pub fun is_audio_stream_playing(stream: AudioStream) bool { ret IsAudioStreamPlaying(stream); }
#[library("raylib")]
ext fun StopAudioStream(stream: AudioStream);
pub fun stop_audio_stream(stream: AudioStream) { StopAudioStream(stream); }
#[library("raylib")]
ext fun SetAudioStreamVolume(stream: AudioStream, volume: f32);
pub fun set_audio_stream_volume(stream: AudioStream, volume: f32) { SetAudioStreamVolume(stream, volume); }
#[library("raylib")]
ext fun SetAudioStreamPitch(stream: AudioStream, pitch: f32);
pub fun set_audio_stream_pitch(stream: AudioStream, pitch: f32) { SetAudioStreamPitch(stream, pitch); }
#[library("raylib")]
ext fun SetAudioStreamPan(stream: AudioStream, pan: f32);
pub fun set_audio_stream_pan(stream: AudioStream, pan: f32) { SetAudioStreamPan(stream, pan); }
#[library("raylib")]
ext fun SetAudioStreamBufferSizeDefault(size: i32);
pub fun set_audio_stream_buffer_size_default(size: i32) { SetAudioStreamBufferSizeDefault(size); }
#[library("raylib")]
ext fun SetAudioStreamCallback(stream: AudioStream, callback: AudioCallback);
pub fun set_audio_stream_callback(stream: AudioStream, callback: AudioCallback) { SetAudioStreamCallback(stream, callback); }
#[library("raylib")]
ext fun AttachAudioStreamProcessor(stream: AudioStream, processor: AudioCallback);
pub fun attach_audio_stream_processor(stream: AudioStream, processor: AudioCallback) { AttachAudioStreamProcessor(stream, processor); }
#[library("raylib")]
ext fun DetachAudioStreamProcessor(stream: AudioStream, processor: AudioCallback);
pub fun detach_audio_stream_processor(stream: AudioStream, processor: AudioCallback) { DetachAudioStreamProcessor(stream, processor); }
#[library("raylib")]
ext fun AttachAudioMixedProcessor(processor: AudioCallback);
pub fun attach_audio_mixed_processor(processor: AudioCallback) { AttachAudioMixedProcessor(processor); }
#[library("raylib")]
ext fun DetachAudioMixedProcessor(processor: AudioCallback);
pub fun detach_audio_mixed_processor(processor: AudioCallback) { DetachAudioMixedProcessor(processor); }
