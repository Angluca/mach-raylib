pub fun load_wave(fileName: *u8) Wave { ret LoadWave(fileName); }
#[library("raylib")]
ext fun LoadWaveFromMemory(fileType: *u8, fileData: *u8, dataSize: i32) Wave;
pub fun load_wave_from_memory(fileType: *u8, fileData: *u8, dataSize: i32) Wave { ret LoadWaveFromMemory(fileType, fileData, dataSize); }
#[library("raylib")]
ext fun IsWaveValid(wave: Wave) bool;
pub fun is_wave_valid(wave: Wave) bool { ret IsWaveValid(wave); }
