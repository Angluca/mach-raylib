#[library("raylib")] pub ext rec rAudioBuffer {}
#[library("raylib")] pub ext rec rAudioProcessor {}

pub rec Vector2 {
      x: f32;
      y: f32;
}
pub rec Vector3 {
      x: f32;
      y: f32;
      z: f32;
}
pub rec Vector4 {
      x: f32;
      y: f32;
      z: f32;
      w: f32;
}
pub rec Matrix {
      m0: f32;
      m4: f32;
      m8: f32;
      m12: f32;
      m1: f32;
      m5: f32;
      m9: f32;
      m13: f32;
      m2: f32;
      m6: f32;
      m10: f32;
      m14: f32;
      m3: f32;
      m7: f32;
      m11: f32;
      m15: f32;
}
pub rec Color {
      r: u8;
      g: u8;
      b: u8;
      a: u8;
}
pub rec Rectangle {
      x: f32;
      y: f32;
      width: f32;
      height: f32;
}
pub rec Image {
      data: ptr;
      width: i32;
      height: i32;
      mipmaps: i32;
      format: i32;
}
pub rec Texture {
      id: u32;
      width: i32;
      height: i32;
      mipmaps: i32;
      format: i32;
}
pub rec RenderTexture {
      id: u32;
      texture: Texture;
      depth: Texture;
}
pub rec NPatchInfo {
      source: Rectangle;
      left: i32;
      top: i32;
      right: i32;
      bottom: i32;
      layout: i32;
}
pub rec GlyphInfo {
      value: i32;
      offsetX: i32;
      offsetY: i32;
      advanceX: i32;
      image: Image;
}
pub rec Font {
      baseSize: i32;
      glyphCount: i32;
      glyphPadding: i32;
      texture: Texture2D;
      recs: *Rectangle;
      glyphs: *GlyphInfo;
}
pub rec Camera3D {
      position: Vector3;
      target: Vector3;
      up: Vector3;
      fovy: f32;
      projection: i32;
}
pub rec Camera2D {
      offset: Vector2;
      target: Vector2;
      rotation: f32;
      zoom: f32;
}
pub rec Mesh {
      vertexCount: i32;
      triangleCount: i32;
      vertices: *f32;
      texcoords: *f32;
      texcoords2: *f32;
      normals: *f32;
      tangents: *f32;
      colors: *u8;
      indices: *u16;
      boneCount: i32;
      boneIndices: *u8;
      boneWeights: *f32;
      animVertices: *f32;
      animNormals: *f32;
      vaoId: u32;
      vboId: *u32;
}
pub rec Shader {
      id: u32;
      locs: *i32;
}
pub rec MaterialMap {
      texture: Texture2D;
      color: Color;
      value: f32;
}
pub rec Material {
      shader: Shader;
      maps: *MaterialMap;
      params: [4]f32;
}
pub rec Transform {
      translation: Vector3;
      rotation: Quaternion;
      scale: Vector3;
}
pub rec BoneInfo {
      name: [32]u8;
      parent: i32;
}
pub rec ModelSkeleton {
      boneCount: u32;
      bones: *BoneInfo;
      bindPose: ModelAnimPose;
}
pub rec Model {
      transform: Matrix;
      meshCount: i32;
      materialCount: i32;
      meshes: *Mesh;
      materials: *Material;
      meshMaterial: *i32;
      skeleton: ModelSkeleton;
      currentPose: ModelAnimPose;
      boneMatrices: *Matrix;
}
pub rec ModelAnimation {
      name: [32]u8;
      boneCount: u32;
      keyframeCount: i32;
      keyframePoses: *ModelAnimPose;
}
pub rec Ray {
      position: Vector3;
      direction: Vector3;
}
pub rec RayCollision {
      hit: bool;
      distance: f32;
      point: Vector3;
      normal: Vector3;
}
pub rec BoundingBox {
      min: Vector3;
      max: Vector3;
}
pub rec Wave {
      frameCount: u32;
      sampleRate: u32;
      sampleSize: u32;
      channels: u32;
      data: ptr;
}
pub rec AudioStream {
      buffer: *rAudioBuffer;
      processor: *rAudioProcessor;
      sampleRate: u32;
      sampleSize: u32;
      channels: u32;
}
pub rec Sound {
      stream: AudioStream;
      frameCount: u32;
}
pub rec Music {
      stream: AudioStream;
      frameCount: u32;
      looping: bool;
      ctxType: i32;
      ctxData: ptr;
}
pub rec VrDeviceInfo {
      hResolution: i32;
      vResolution: i32;
      hScreenSize: f32;
      vScreenSize: f32;
      eyeToScreenDistance: f32;
      lensSeparationDistance: f32;
      interpupillaryDistance: f32;
      lensDistortionValues: [4]f32;
      chromaAbCorrection: [4]f32;
}
pub rec VrStereoConfig {
      projection: [2]Matrix;
      viewOffset: [2]Matrix;
      leftLensCenter: [2]f32;
      rightLensCenter: [2]f32;
      leftScreenCenter: [2]f32;
      rightScreenCenter: [2]f32;
      scale: [2]f32;
      scaleIn: [2]f32;
}
pub rec FilePathList {
      count: u32;
      paths: *str;
}
pub rec AutomationEvent {
      frame: u32;
      type: u32;
      params: [4]i32;
}
pub rec AutomationEventList {
      capacity: u32;
      count: u32;
      events: *AutomationEvent;
}
pub def Quaternion: Vector4;
pub def Texture2D: Texture;
pub def TextureCubemap: Texture;
pub def RenderTexture2D: RenderTexture;
pub def Camera: Camera3D;
pub def ModelAnimPose: *Transform;
