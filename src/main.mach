use std.runtime;
use rl: raylib.raylib;
#use rm: raylib.raymath;
#use rc: raylib.rcamera;
#use rg: raylib.rlgl;
#use ri: raylib.raygui;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    # -- Init -----------
    val sw: i32 = 200;
    val sh: i32 = 150;
    rl.init_window(sw, sh, "^^v");
    rl.set_target_fps(60);

    val color: rl.Color = rl.Color{ r: 200, g: 100, b: 90, a: 255 };
    # --- Main loop -----
    for (!rl.window_should_close()) {
        # -- Update -----

        # -- Draw -------
        rl.begin_drawing();
            rl.clear_background(rl.LIGHTGRAY);
            rl.draw_text("Mach", 40, 76, 40, color);
            rl.draw_text("raylib", 72, 100, 40, rl.BLACK);
        rl.end_drawing();
    } # -----------------

    # --- DeInit --------
    rl.close_window();

    ret 0;
}
