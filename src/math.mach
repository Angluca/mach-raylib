# mach math library: floating point math for game development
# implemented using taylor series and newton's method.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;

# --- 数学常数 ---
val PI: f32 = 3.14159265358979323846;
val PI_2: f32 = 1.57079632679489661923;
val TWO_PI: f32 = 6.28318530717958647692;
val E: f32 = 2.71828182845904523536;
val LN2: f32 = 0.69314718055994530942;

# 极小值误差范围，用于浮点数安全比较
val EPSILON: f32 = 0.000001;

# ==========================================
# 1. 基础函数
# ==========================================

pub fun absf(v: f32) f32 {
    if (v < 0.0) { ret 0.0 - v; }
    ret v;
}

# 平铺 (向下取整)
pub fun floorf(v: f32) f32 {
    val i: i64 = v::i64;
    # 使用 EPSILON 判断浮点数与整数是否相等
    if (v < 0.0 && absf(i::f32 - v) > EPSILON) {
        ret (i - 1)::f32;
    }
    ret i::f32;
}

# 天花板 (向上取整)
pub fun ceilf(v: f32) f32 {
    val i: i64 = v::i64;
    if (v > 0.0 && absf(i::f32 - v) > EPSILON) {
        ret (i + 1)::f32;
    }
    ret i::f32;
}

# 四舍五入
pub fun roundf(v: f32) f32 {
    if (v < 0.0) {
        ret (v - 0.5)::i64::f32;
    }
    ret (v + 0.5)::i64::f32;
}

# 浮点数取余
pub fun fmodf(a: f32, b: f32) f32 {
    # 不能用 b == 0.0，必须判断 b 是否接近 0
    if (absf(b) < EPSILON) { ret 0.0; }
    val quot: f32 = a / b;
    val int_part: f32 = quot::i64::f32;
    ret a - int_part * b;
}

# 判断两个浮点数是否近似相等
pub fun approxf(a: f32, b: f32) bool {
    ret absf(a - b) < EPSILON;
}

# ==========================================
# 2. 插值与映射
# ==========================================

pub fun lerpf(a: f32, b: f32, t: f32) f32 {
    ret a + (b - a) * t;
}

pub fun mapf(v: f32, in_min: f32, in_max: f32, out_min: f32, out_max: f32) f32 {
    # 安全判断：分母接近 0 时直接返回 out_min
    if (absf(in_max - in_min) < EPSILON) { ret out_min; }
    val t: f32 = (v - in_min) / (in_max - in_min);
    ret out_min + t * (out_max - out_min);
}

pub fun clampf(v: f32, lo: f32, hi: f32) f32 {
    if (v < lo) { ret lo; }
    if (v > hi) { ret hi; }
    ret v;
}

# ==========================================
# 3. 幂与根号
# ==========================================

# 平方根
pub fun sqrtf(v: f32) f32 {
    # 小于等于 0 的情况，使用 EPSILON 保护
    if (v < EPSILON) { ret 0.0; }
    var x: f32 = v;
    x = 0.5 * x + 0.5 * (v / x);
    x = 0.5 * x + 0.5 * (v / x);
    x = 0.5 * x + 0.5 * (v / x);
    x = 0.5 * x + 0.5 * (v / x);
    x = 0.5 * x + 0.5 * (v / x);
    ret x;
}

# 指数 e^x
pub fun expf(x: f32) f32 {
    if (x < -20.0) { ret 0.0; }
    if (x > 80.0) { ret 1e30; }

    var term: f32 = 1.0;
    var sum: f32 = 1.0;
    var i: i64 = 1;

    for (i < 20) {
        term = term * x / i::f32;
        sum = sum + term;
        i = i + 1;
    }
    ret sum;
}

# 自然对数 ln(x)
pub fun logf(x: f32) f32 {
    # 小于等于 0 的情况，使用 EPSILON 保护
    if (x < EPSILON) { ret -1e30; }

    var v: f32 = x;
    var exp: i64 = 0;

    for (v >= 2.0) {
        v = v * 0.5;
        exp = exp + 1;
    }
    for (v < 1.0) {
        v = v * 2.0;
        exp = exp - 1;
    }

    val t: f32 = (v - 1.0) / (v + 1.0);
    var t2: f32 = t * t;
    var term: f32 = t;
    var sum: f32 = t;
    var i: i64 = 1;

    for (i < 15) {
        term = term * t2;
        sum = sum + term / (2 * i + 1)::f32;
        i = i + 1;
    }

    ret 2.0 * sum + exp::f32 * LN2;
}

# 幂函数 x^y
pub fun powf(x: f32, y: f32) f32 {
    # x 接近 0 时
    if (absf(x) < EPSILON) {
        if (y > 0.0) { ret 0.0; }
        ret 1e30;
    }
    ret expf(y * logf(x));
}

# ==========================================
# 4. 三角函数
# ==========================================

pub fun sinf(x: f32) f32 {
    var v: f32 = x;
    for (v > PI) { v = v - TWO_PI; }
    for (v < -PI) { v = v + TWO_PI; }

    var term: f32 = v;
    var sum: f32 = v;
    var v2: f32 = v * v;
    var i: i64 = 1;

    for (i < 8) {
        term = -term * v2 / ((2 * i)::f32 * (2 * i + 1)::f32);
        sum = sum + term;
        i = i + 1;
    }
    ret sum;
}

pub fun cosf(x: f32) f32 {
    ret sinf(x + PI_2);
}

pub fun tanf(x: f32) f32 {
    val c: f32 = cosf(x);
    # 不能用 c == 0.0，判断余弦值是否接近 0 (此时角度接近 PI/2，正切值无穷大)
    if (absf(c) < EPSILON) { ret 1e30; }
    ret sinf(x) / c;
}

pub fun atanf(x: f32) f32 {
    var v: f32 = x;
    var sign: f32 = 1.0;
    var offset: f32 = 0.0;

    if (v < 0.0) {
        v = -v;
        sign = -1.0;
    }

    if (v > 1.0) {
        v = 1.0 / v;
        offset = PI_2;
    }

    var v2: f32 = v * v;
    var term: f32 = v;
    var sum: f32 = v;
    var i: i64 = 1;

    for (i < 10) {
        term = -term * v2;
        sum = sum + term / (2 * i + 1)::f32;
        i = i + 1;
    }

    if (offset > 0.0) {
        ret sign * (PI_2 - sum);
    }
    ret sign * sum;
}

# 双参数反正切 atan2(y, x)
pub fun atan2f(y: f32, x: f32) f32 {
    if (x > EPSILON) {
        ret atanf(y / x);
    }
    if (x < -EPSILON) {
        if (y >= 0.0) { ret atanf(y / x) + PI; }
        ret atanf(y / x) - PI;
    }
    # x 接近 0 的情况
    if (y > EPSILON) { ret PI_2; }
    if (y < -EPSILON) { ret -PI_2; }
    ret 0.0; # (0,0)
}

# ==========================================
# 5. 角度转换
# ==========================================

pub fun rad2deg(rad: f32) f32 {
    ret rad * (180.0 / PI);
}

pub fun deg2rad(deg: f32) f32 {
    ret deg * (PI / 180.0);
}

