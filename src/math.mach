use std.types.bool.bool;

val PI: f64      = 3.141592653589793;
val PI_2: f64    = 1.5707963267948966;
val PI_4: f64    = 0.7853981633974483;
val TWO_PI: f64  = 6.283185307179586;
val EPSILON: f32 = 0.000001;
val BIG: f32     = 1e30;

$if ($mach.build.os == $mach.os.darwin) {
    val C_MATH_LIB: *u8 = "libSystem";
}
$or ($mach.build.os == $mach.os.windows) {
    val C_MATH_LIB: *u8 = "ucrtbase";
}
$or {
    val C_MATH_LIB: *u8 = "m";
}

#[library(C_MATH_LIB)]
pub ext fun sinf(x: f32) f32;
#[library(C_MATH_LIB)]
pub ext fun cosf(x: f32) f32;
#[library(C_MATH_LIB)]
pub ext fun tanf(x: f32) f32;
#[library(C_MATH_LIB)]
pub ext fun atanf(x: f32) f32;
#[library(C_MATH_LIB)]
pub ext fun atan2f(y: f32, x: f32) f32;
#[library(C_MATH_LIB)]
pub ext fun asinf(x: f32) f32;
#[library(C_MATH_LIB)]
pub ext fun acosf(x: f32) f32;
#[library(C_MATH_LIB)]
pub ext fun powf(x: f32, y: f32) f32;
#[library(C_MATH_LIB)]
pub ext fun sqrtf(x: f32) f32;
#[library(C_MATH_LIB)]
pub ext fun expf(x: f32) f32;
#[library(C_MATH_LIB)]
pub ext fun logf(x: f32) f32;
#[library(C_MATH_LIB)]
pub ext fun log10f(x: f32) f32;
#[library(C_MATH_LIB)]
pub ext fun floorf(x: f32) f32;
#[library(C_MATH_LIB)]
pub ext fun ceilf(x: f32) f32;
#[library(C_MATH_LIB)]
pub ext fun roundf(x: f32) f32;
#[library(C_MATH_LIB)]
pub ext fun truncf(x: f32) f32;
#[library(C_MATH_LIB)]
pub ext fun fmodf(a: f32, b: f32) f32;
#[library(C_MATH_LIB)]
pub ext fun fabsf(x: f32) f32;

# ---------------------------------
pub fun is_nan(v: f32) bool {
    ret v != v;
}

pub fun is_inf(v: f32) bool {
    val b: u32 = v :~ u32;
    ret (b & 0x7FFF_FFFF) == 0x7F80_0000;
}

pub fun is_finite(v: f32) bool {
    ret !is_nan(v) && !is_inf(v);
}

# 平滑阶跃（相机、UI 过渡）
pub fun smoothstepf(t: f32) f32 {
    var x: f32 = t;
    if (x < 0.0) { x = 0.0; }
    if (x > 1.0) { x = 1.0; }
    ret x * x * (3.0 - 2.0 * x);
}

# 帧率无关的指数平滑（相机跟随）
pub fun dampf(current: f32, target: f32, lambda: f32, dt: f32) f32 {
    val t: f32 = 1.0 - expf(0.0 - lambda * dt);
    ret current + (target - current) * t;
}

# 以固定速度向目标移动（标量版，raymath 只有 Vector2 版）
pub fun move_towardsf(current: f32, target: f32, max_delta: f32) f32 {
    val d: f32 = target - current;
    if (fabsf(d) <= max_delta) { ret target; }
    if (d > 0.0) { ret current + max_delta; }
    ret current - max_delta;
}

# 最短路径角度插值（raymath 没有标量版，只有 Quaternion 间接做）
pub fun lerp_anglef(from: f32, to: f32, t: f32) f32 {
    var delta: f32 = fmodf(to - from, TWO_PI::f32);
    if (delta > PI::f32)       { delta = delta - TWO_PI::f32; }
    if (delta < 0.0 - PI::f32) { delta = delta + TWO_PI::f32; }
    ret from + delta * t;
}

# 乒乓往返（UI 脉冲、呼吸动画）
pub fun ping_pongf(v: f32, length: f32) f32 {
    if (length <= 0.0) { ret 0.0; }
    var t: f32 = fmodf(v, length * 2.0);
    if (t < 0.0) { t = t + length * 2.0; }
    if (t <= length) { ret t; }
    ret length * 2.0 - t;
}

# 死区（摇杆输入去抖）
pub fun deadzonef(v: f32, threshold: f32) f32 {
    if (fabsf(v) < threshold) { ret 0.0; }
    ret v;
}

# 吸附到 step 的整数倍（网格吸附、像素对齐）
pub fun snapf(v: f32, step: f32) f32 {
    if (step <= 0.0) { ret v; }
    ret roundf(v / step) * step;
}
